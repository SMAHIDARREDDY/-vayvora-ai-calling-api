# Vayvora AI Calling — environment template
#
# Copy to .env and fill in real values. .env is gitignored; never commit it.
# Every value here is a placeholder, not a working credential.

# ---------------------------------------------------------------------------
# Database
#
# SAMPLE URL — replace with the real connection string when it is available.
# Format: jdbc:postgresql://<host>:<port>/<database>
# Managed providers usually also need ?sslmode=require on the end.
# ---------------------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/vayvora_db
DB_USERNAME=vayvora
DB_PASSWORD=change_me
DB_POOL_SIZE=10

# Schema is owned by the SQL files in db/migration. Hibernate only checks that
# the tables it expects exist. Set to "none" to skip even that check.
JPA_DDL_AUTO=validate

# ---------------------------------------------------------------------------
# JWT
#
# Must be at least 32 bytes and IDENTICAL across the auth service and the
# gateway, or tokens issued by one will fail verification at the other.
# Generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_bytes
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ---------------------------------------------------------------------------
# Service discovery
#
# Host names when running locally. In Docker or Kubernetes these become the
# service names, e.g. http://auth-service:8001.
# ---------------------------------------------------------------------------
AUTH_SERVICE_URI=http://localhost:8001
AGENT_SERVICE_URI=http://localhost:8003
CALL_SERVICE_URI=http://localhost:8004
CAMPAIGN_SERVICE_URI=http://localhost:8005
ANALYTICS_SERVICE_URI=http://localhost:8006
KNOWLEDGE_SERVICE_URI=http://localhost:8007

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BROKERS=localhost:9092

# ---------------------------------------------------------------------------
# CORS
#
# Comma-separated origins allowed to call the gateway from a browser.
# Defaults cover the Flutter web dev server (8080) and Angular (4200).
# A wildcard is rejected here because credentials are enabled.
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:4200

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=DEBUG
GATEWAY_LOG_LEVEL=INFO
